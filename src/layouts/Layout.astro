---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import { siteConfig } from "../data/site-config";

// Cloudflare Web Analytics laadt enkel wanneer er een token ingesteld is.
const analyticsToken = siteConfig.cloudflareAnalyticsToken?.trim() ?? "";

// Aankondigingsbalk voor de wafelenbak: sitebreed, tot en met de dag van het
// event, en niet op de wafelenbakpagina zelf (daar is ze overbodig).
const wafel = siteConfig.wafelenbak;
const wafelISO = (wafel.datumISO || "").trim();
const vandaagISO = new Date().toISOString().slice(0, 10);
const toonWafelBalk =
  wafelISO.length > 0 &&
  wafelISO >= vandaagISO &&
  !Astro.url.pathname.startsWith("/wafelenbak");
const wafelDatumKort = wafelISO
  ? new Date(wafelISO + "T12:00:00").toLocaleDateString("nl-BE", { day: "numeric", month: "long" })
  : "";

// Self-hosted lettertypes (variabel) — geen externe request naar Google Fonts.
// Fraunces (titels), Inter (lopende tekst), Caveat (handgeschreven accent).
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource-variable/caveat";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const { title, description, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1c211f" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
  </head>
  <body>
    <a href="#main" class="skip-link">Ga naar inhoud</a>
    {toonWafelBalk && (
      <a
        href="/wafelenbak"
        class="block bg-goud-500 px-4 py-2 text-center text-sm font-semibold text-antraciet-900 hover:bg-goud-600"
      >
        🧇 Wafelenbak op {wafelDatumKort} — registreer of bestel je wafels →
      </a>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Cloudflare Web Analytics: cookieloos, geen persoonlijke profilering. */}
    {analyticsToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </body>
</html>
