---
import { siteConfig } from "../data/site-config";

interface OrganizationProps {
  kind: "Organization";
}

interface EventProps {
  kind: "Event";
  name: string;
  description: string;
  startDate: string;
  endDate?: string;
  location: string;
  url: string;
  eventStatus?: "scheduled" | "cancelled";
  // Standaard "SportsEvent" (de uitdagingen). Voor bv. de wafelenbak: "Event".
  eventType?: "SportsEvent" | "Event" | "FoodEvent";
  address?: { straat: string; postcode: string; gemeente: string; land: string };
  // Prijs per stuk in euro (bv. 2.5) — toont een aanbod bij het event.
  price?: number;
  // Vanaf wanneer het aanbod beschikbaar is (ISO-datum), vereist door Google.
  offerValidFrom?: string;
  image?: string;
}

interface ArticleProps {
  kind: "Article";
  headline: string;
  description: string;
  datePublished: string;
  dateModified?: string;
  author: string;
  image?: string;
  url: string;
}

type Props = OrganizationProps | EventProps | ArticleProps;

const props = Astro.props as Props;

let json: Record<string, unknown> = {};

if (props.kind === "Organization") {
  // Dit is een persoonlijk initiatief, geen geregistreerde vzw/NGO. We gebruiken
  // daarom het neutrale type "Organization" met een duidelijke beschrijving en
  // initiatiefnemer, en koppelen er meteen de WebSite aan via een @graph.
  json = {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": `${siteConfig.url}/#organization`,
        name: siteConfig.projectName,
        url: siteConfig.url,
        email: siteConfig.email,
        logo: {
          "@type": "ImageObject",
          url: `${siteConfig.url}/logo.png`,
          width: 512,
          height: 512,
        },
        image: `${siteConfig.url}/images/social-share.jpg`,
        sameAs: [siteConfig.facebookUrl, siteConfig.instagramUrl].filter(Boolean),
        description: siteConfig.tagline,
        founder: { "@id": `${siteConfig.url}/#initiatiefnemer` },
        // Giften lopen via de officiële actiepagina van Kom op tegen Kanker.
        potentialAction: {
          "@type": "DonateAction",
          name: "Steun het project via Kom op tegen Kanker",
          target: siteConfig.donationUrl,
          recipient: {
            "@type": "Organization",
            name: "Kom op tegen Kanker",
            url: "https://www.komoptegenkanker.be",
          },
        },
      },
      {
        "@type": "Person",
        "@id": `${siteConfig.url}/#initiatiefnemer`,
        name: siteConfig.initiatiefnemer,
        url: `${siteConfig.url}/het-verhaal`,
      },
      {
        "@type": "WebSite",
        "@id": `${siteConfig.url}/#website`,
        url: siteConfig.url,
        name: siteConfig.projectName,
        description: siteConfig.tagline,
        inLanguage: "nl-BE",
        publisher: { "@id": `${siteConfig.url}/#organization` },
      },
    ],
  };
} else if (props.kind === "Event") {
  json = {
    "@context": "https://schema.org",
    "@type": props.eventType ?? "SportsEvent",
    name: props.name,
    description: props.description,
    startDate: props.startDate,
    ...(props.endDate ? { endDate: props.endDate } : {}),
    eventStatus:
      props.eventStatus === "cancelled"
        ? "https://schema.org/EventCancelled"
        : "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: props.location,
      ...(props.address
        ? {
            address: {
              "@type": "PostalAddress",
              streetAddress: props.address.straat,
              postalCode: props.address.postcode,
              addressLocality: props.address.gemeente,
              addressCountry: props.address.land,
            },
          }
        : {}),
    },
    image: new URL(props.image ?? "/images/social-share.jpg", siteConfig.url).toString(),
    url: props.url,
    inLanguage: "nl-BE",
    ...(props.price != null
      ? {
          offers: {
            "@type": "Offer",
            price: props.price.toFixed(2),
            priceCurrency: "EUR",
            availability: "https://schema.org/InStock",
            ...(props.offerValidFrom ? { validFrom: props.offerValidFrom } : {}),
            url: props.url,
          },
        }
      : {}),
    organizer: {
      "@type": "Organization",
      "@id": `${siteConfig.url}/#organization`,
      name: siteConfig.projectName,
      url: siteConfig.url,
    },
    // Bij de sportieve uitdagingen is de initiatiefnemer ook de deelnemer.
    // Bij een wafelenbak treedt niemand op: de organisatie zelf is de uitvoerder.
    performer:
      (props.eventType ?? "SportsEvent") === "SportsEvent"
        ? { "@type": "Person", name: siteConfig.initiatiefnemer }
        : { "@type": "Organization", "@id": `${siteConfig.url}/#organization`, name: siteConfig.projectName },
  };
} else if (props.kind === "Article") {
  json = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: props.headline,
    description: props.description,
    datePublished: props.datePublished,
    dateModified: props.dateModified ?? props.datePublished,
    author: {
      "@type": "Person",
      name: props.author,
    },
    ...(props.image ? { image: props.image } : {}),
    url: props.url,
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(json)} />
