---
// Sponsors in drie niveaus (zoals in het sponsordossier). Gegevens komen uit
// src/data/sponsors.json. Een niveau zonder sponsors wordt niet getoond, en
// een hoger niveau verschijnt vanzelf bovenaan zodra er een sponsor in zit.
import sponsors from "../data/sponsors.json";

type Level = "hoofdsponsor" | "projectsponsor" | "lokale-partner";

interface Sponsor {
  name: string;
  logo: string;
  website?: string;
  level?: Level;
  // Enkel hoofdsponsors: korte uitleg over het bedrijf en hun bijdrage. Is een
  // van beide ingevuld, dan is het logo klikbaar en opent er een infovenster.
  description?: string;
  contribution?: string;
}

const list = (sponsors as Sponsor[])
  .map((s, i) => ({ ...s, level: (s.level ?? "lokale-partner") as Level, key: `sponsor-${i}` }))
  // Binnen een niveau altijd alfabetisch (hoofdletters en accenten tellen niet mee),
  // zodat er geen discussie kan zijn over wie bovenaan staat.
  .sort((a, b) => a.name.localeCompare(b.name, "nl", { sensitivity: "base" }));

const tiers = [
  {
    level: "hoofdsponsor" as Level,
    title: "Hoofdsponsors",
    tile: "min-w-28 max-w-full p-3",
    img: "h-28 sm:h-40 w-auto max-w-[22rem] flex-none object-contain",
  },
  {
    level: "projectsponsor" as Level,
    title: "Projectsponsors",
    tile: "min-w-24 max-w-full p-2",
    img: "h-24 sm:h-32 w-auto max-w-[15rem] flex-none object-contain",
  },
  {
    level: "lokale-partner" as Level,
    title: "Lokale partners",
    tile: "min-w-20 max-w-full p-2",
    img: "h-14 sm:h-16 w-auto max-w-[16rem] flex-none object-contain",
  },
].map((t) => ({ ...t, items: list.filter((s) => s.level === t.level) }))
  .filter((t) => t.items.length > 0);

const tileBase =
  "flex items-center justify-center rounded-card border border-beige-200 bg-white transition-colors";
const tileLink = `${tileBase} hover:border-goud-500`;
---

{list.length === 0 ? (
  <div class="relative overflow-hidden rounded-card border border-beige-200 bg-beige-100/60 px-6 py-14 text-center">
    <img
      src="/images/tree-mark.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -left-10 -bottom-16 w-56 opacity-[0.07]"
    />
    <img
      src="/images/tree-mark.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -right-10 -top-16 w-56 rotate-180 opacity-[0.07]"
    />
    <p class="relative font-display text-2xl font-semibold text-antraciet-900">
      Binnenkort onze steunpilaren
    </p>
    <p class="relative mt-2 font-accent text-2xl text-goud-700">💛 Samen maken we het verschil.</p>
    <p class="relative mx-auto mt-3 max-w-md text-antraciet-700">
      Hier verschijnen de mensen, bedrijven en organisaties die mee hun schouders onder dit
      verhaal zetten.
    </p>
    <a
      href="/steunen"
      class="relative mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-antraciet-900 px-6 py-3 text-sm font-semibold text-beige-50"
    >
      Bouw mee aan dit verhaal
    </a>
  </div>
) : (
  <div class="space-y-14">
    {tiers.map((tier) => (
      <section aria-labelledby={`niveau-${tier.level}`}>
        <h2
          id={`niveau-${tier.level}`}
          class="text-center font-display text-2xl font-semibold text-antraciet-900"
        >
          {tier.title}
        </h2>
        <ul class="mt-6 flex flex-wrap justify-center gap-4 sm:gap-6">
          {tier.items.map((s) => {
            const heeftInfo = tier.level === "hoofdsponsor" && Boolean(s.description || s.contribution);
            return (
              <li>
                {heeftInfo ? (
                  <button
                    type="button"
                    popovertarget={s.key}
                    class:list={[tileLink, tier.tile, "cursor-pointer"]}
                    aria-label={`${s.name}: meer informatie`}
                  >
                    <img src={s.logo} alt={s.name} class={tier.img} loading="lazy" />
                  </button>
                ) : s.website ? (
                  <a
                    href={s.website}
                    target="_blank"
                    rel="sponsored noopener noreferrer"
                    class:list={[tileLink, tier.tile]}
                    aria-label={`${s.name} (opent in een nieuw tabblad)`}
                  >
                    <img src={s.logo} alt={s.name} class={tier.img} loading="lazy" />
                  </a>
                ) : (
                  <div class:list={[tileBase, tier.tile]}>
                    <img src={s.logo} alt={s.name} class={tier.img} loading="lazy" />
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
)}

{/* Infovensters voor hoofdsponsors: native HTML-popover, werkt zonder JavaScript. */}
{list
  .filter((s) => s.level === "hoofdsponsor" && (s.description || s.contribution))
  .map((s) => (
    <div
      id={s.key}
      popover
      class="m-auto w-[min(92vw,32rem)] rounded-card border border-beige-200 bg-white p-6 text-antraciet-800 shadow-xl backdrop:bg-antraciet-900/50 sm:p-8"
    >
      <div class="flex items-start justify-between gap-4">
        <img src={s.logo} alt="" aria-hidden="true" class="max-h-14 max-w-[10rem] object-contain" />
        <button
          type="button"
          popovertarget={s.key}
          popovertargetaction="hide"
          class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-beige-200 text-xl leading-none hover:border-goud-500"
          aria-label="Sluiten"
        >
          ×
        </button>
      </div>
      <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-bos-600">Hoofdsponsor</p>
      <h3 class="mt-1 font-display text-2xl font-semibold text-antraciet-900">{s.name}</h3>
      {s.description && <p class="mt-3 leading-relaxed">{s.description}</p>}
      {s.contribution && (
        <p class="mt-3 leading-relaxed">
          <span class="font-semibold text-antraciet-900">Bijdrage:</span> {s.contribution}
        </p>
      )}
      {s.website && (
        <a
          href={s.website}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="mt-5 inline-block font-semibold text-goud-700 underline"
        >
          Bezoek de website ↗
        </a>
      )}
    </div>
  ))}
