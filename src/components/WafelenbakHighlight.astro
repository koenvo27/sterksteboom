---
import { siteConfig } from "../data/site-config";
import Button from "./Button.astro";

const w = siteConfig.wafelenbak;
const iso = (w.datumISO || "").trim();
// Toon de highlight tot en met de dag van het event; daarna verdwijnt hij.
const vandaag = new Date().toISOString().slice(0, 10);
const aankomend = iso.length > 0 && iso >= vandaag;
---

{aankomend && (
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
    <div class="rounded-card border border-goud-300 bg-goud-50 p-8 sm:p-10">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <p class="font-body text-sm font-semibold uppercase tracking-wide text-bos-600">
            Eerstvolgende actie
          </p>
          <h2 class="mt-1 font-display text-3xl sm:text-4xl font-semibold text-antraciet-900">
            Wafelenbak 🧇
          </h2>
          <p class="mt-2 font-accent text-xl text-bos-600">{w.datum}</p>
          <p class="mt-3 text-antraciet-700">
            Kom ter plaatse wafels eten of bestel afhaalpakketten — met grote tombola. De volledige
            opbrengst gaat naar Kom op tegen Kanker. Registreer je vooraf.
          </p>
        </div>
        <div class="shrink-0">
          <Button href="/wafelenbak" variant="primary">Registreren en bestellen</Button>
        </div>
      </div>
    </div>
  </section>
)}
