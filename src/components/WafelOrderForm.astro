---
import { siteConfig } from "../data/site-config";
import Button from "./Button.astro";

const w = siteConfig.wafelenbak;
const hasEndpoint = siteConfig.formEndpoint.trim().length > 0;

// AJAX-variant van FormSubmit zodat we op de pagina kunnen blijven en de
// betaalstap kunnen tonen. Zonder JS valt het formulier terug op een gewone
// POST naar het klassieke endpoint met redirect naar /bedankt.
const ajaxEndpoint = siteConfig.formEndpoint.replace(
  "formsubmit.co/",
  "formsubmit.co/ajax/"
);
const bedanktUrl = new URL("/bedankt", siteConfig.url).toString();

// Registratie-endpoint: een Google Apps Script "web-app" (bewaart in een
// Google Sheet) wanneer ingesteld, anders FormSubmit (e-mail). De JS-client
// gebruikt no-cors voor de Apps Script-route; zonder JS post het formulier
// rechtstreeks naar formAction.
const registratieEndpoint = (w.registratieEndpoint || "").trim();
const useSheet = registratieEndpoint.length > 0;
const postEndpoint = useSheet ? registratieEndpoint : ajaxEndpoint;
const formAction = useSheet ? registratieEndpoint : siteConfig.formEndpoint;

// Prijs netjes als Belgisch euro-bedrag tonen (server-side voorbeeld).
const euro = (n: number) =>
  new Intl.NumberFormat("nl-BE", {
    style: "currency",
    currency: "EUR",
  }).format(n);

// Configuratie die de inline-client nodig heeft. In een string gieten en via
// set:html injecteren voorkomt dat Astro struikelt over accolades in JS.
const clientConfig = {
  // Google Sheet (Apps Script): hoofdopslag/overzicht. No-cors = niet leesbaar.
  sheetEndpoint: useSheet ? registratieEndpoint : "",
  // FormSubmit (e-mail): onafhankelijke back-up. Dit antwoord is wél leesbaar,
  // dus hierop baseren we of de bevestiging getoond wordt.
  mailEndpoint: ajaxEndpoint,
  hasMail: hasEndpoint,
  prijsPerPakket: w.prijsPerPakket,
  wafelsPerPakket: w.wafelsPerPakket,
  eenheidMeervoud: w.eenheidMeervoud,
  betaalUrl: w.betaalUrl,
};

// Stijl voor de genummerde bolletjes in de betaalstappen.
const badge =
  "flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-goud-500 text-antraciet-900 text-sm font-semibold";

const script = `
(() => {
  const CFG = ${JSON.stringify(clientConfig)};
  const form = document.getElementById("wafel-form");
  if (!form) return;

  const fmt = (n) =>
    new Intl.NumberFormat("nl-BE", { style: "currency", currency: "EUR" }).format(n);

  const getNum = (id, max) => {
    const el = document.getElementById(id);
    let n = parseInt(el ? el.value : "0", 10);
    if (isNaN(n) || n < 0) n = 0;
    if (n > max) n = max;
    return n;
  };

  const totaalEl = document.getElementById("wafel-totaal");
  const wafelsEl = document.getElementById("wafel-aantal-wafels");
  const naamEl = document.getElementById("naam");

  const updateTotaal = () => {
    const pakketten = getNum("pakketten", 200);
    if (totaalEl) totaalEl.textContent = fmt(pakketten * CFG.prijsPerPakket);
    if (wafelsEl) wafelsEl.textContent = String(pakketten * CFG.wafelsPerPakket);
  };

  ["volwassenen", "kinderen", "pakketten"].forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener("input", updateTotaal);
      el.addEventListener("change", updateTotaal);
    }
  });
  updateTotaal();

  const beschrijf = (volw, kind, pakketten) => {
    const delen = [];
    const personen = [];
    if (volw > 0) personen.push(volw + " volwassene" + (volw === 1 ? "" : "n"));
    if (kind > 0) personen.push(kind + " kind" + (kind === 1 ? "" : "eren") + " (onder 12)");
    if (personen.length) delen.push(personen.join(" en ") + " ter plaatse");
    if (pakketten > 0) {
      delen.push(
        pakketten + " afhaalpakket" + (pakketten === 1 ? "" : "ten") +
        " (" + (pakketten * CFG.wafelsPerPakket) + " " + CFG.eenheidMeervoud + ")"
      );
    }
    return delen.join(" · ");
  };

  const toonBetaalstap = (naam, volw, kind, pakketten) => {
    document.getElementById("betaal-samenvatting").textContent = beschrijf(volw, kind, pakketten);

    // Afhaalbetaling: enkel tonen wanneer er pakketten besteld zijn.
    const afhaal = document.getElementById("betaal-afhaal");
    if (pakketten > 0) {
      const totaal = pakketten * CFG.prijsPerPakket;
      const mededeling = "Wafelenbak - " + (naam || "").trim();
      document.getElementById("betaal-bedrag").textContent = fmt(totaal);
      document.getElementById("betaal-mededeling").textContent = mededeling;
      const kotkBtn = document.getElementById("betaal-kotk");
      if (kotkBtn) kotkBtn.setAttribute("href", CFG.betaalUrl);
      const copyBtn = document.getElementById("copy-mededeling");
      if (copyBtn) {
        copyBtn.addEventListener("click", () => {
          navigator.clipboard && navigator.clipboard.writeText(mededeling).then(() => {
            copyBtn.textContent = "Gekopieerd ✓";
            setTimeout(() => (copyBtn.textContent = "Kopieer mededeling"), 2000);
          });
        });
      }
      afhaal.classList.remove("hidden");
    } else {
      afhaal.classList.add("hidden");
    }

    // Ter-plaatse-nota: enkel tonen wanneer er mensen komen eten.
    const terplaatse = document.getElementById("betaal-terplaatse");
    if (volw + kind > 0) terplaatse.classList.remove("hidden");
    else terplaatse.classList.add("hidden");

    form.classList.add("hidden");
    const stap = document.getElementById("wafel-betaalstap");
    stap.classList.remove("hidden");
    stap.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  // JSONP: stuurt de registratie via een <script>-GET naar Apps Script en
  // leest het antwoord. JSONP omzeilt CORS volledig, dus dit is betrouwbaar
  // leesbaar — in tegenstelling tot een gewone cross-origin fetch.
  function jsonpVerzend(baseUrl, params, timeoutMs) {
    return new Promise(function (resolve, reject) {
      var cbName = "wafelCb_" + Date.now() + "_" + Math.floor(Math.random() * 1e6);
      var parts = ["callback=" + cbName];
      for (var k in params) {
        if (Object.prototype.hasOwnProperty.call(params, k)) {
          parts.push(encodeURIComponent(k) + "=" + encodeURIComponent(params[k]));
        }
      }
      var script = document.createElement("script");
      var done = false;
      var timer = setTimeout(function () {
        if (!done) { cleanup(); reject(new Error("timeout")); }
      }, timeoutMs);
      function cleanup() {
        done = true;
        clearTimeout(timer);
        try { delete window[cbName]; } catch (e) { window[cbName] = undefined; }
        if (script.parentNode) script.parentNode.removeChild(script);
      }
      window[cbName] = function (resp) { if (!done) { cleanup(); resolve(resp); } };
      script.onerror = function () { if (!done) { cleanup(); reject(new Error("script error")); } };
      script.src = baseUrl + (baseUrl.indexOf("?") >= 0 ? "&" : "?") + parts.join("&");
      document.body.appendChild(script);
    });
  }

  form.addEventListener("submit", async (e) => {
    // Honeypot: als het verborgen veld ingevuld is, stilletjes negeren.
    const honey = form.querySelector('[name="_honey"]');
    if (honey && honey.value) { e.preventDefault(); return; }

    const volw = getNum("volwassenen", 50);
    const kind = getNum("kinderen", 50);
    const pakketten = getNum("pakketten", 200);
    const keuzeFout = document.getElementById("wafel-keuze-fout");

    // Minstens iets registreren: ter plaatse komen of pakketten bestellen.
    if (volw + kind + pakketten === 0) {
      e.preventDefault();
      if (keuzeFout) keuzeFout.classList.remove("hidden");
      return;
    }
    if (keuzeFout) keuzeFout.classList.add("hidden");

    // Geen enkel endpoint ingesteld: laat de gewone (native) POST lopen.
    if (!CFG.hasMail && !CFG.sheetEndpoint) return;

    e.preventDefault();
    if (!form.reportValidity()) return;

    const naam = naamEl.value;
    const btn = document.getElementById("wafel-submit");
    const foutEl = document.getElementById("wafel-fout");
    if (foutEl) foutEl.classList.add("hidden");
    if (btn) { btn.disabled = true; btn.textContent = "Bezig met registreren…"; }

    try {
      const data = new FormData(form);
      data.set("aantal_volwassenen", String(volw));
      data.set("aantal_kinderen_onder_12", String(kind));
      data.set("aantal_afhaalpakketten", String(pakketten));
      data.set("aantal_dubbele_wafels_afhaal", String(pakketten * CFG.wafelsPerPakket));
      data.set("te_betalen_afhaal", fmt(pakketten * CFG.prijsPerPakket));

      // 1) E-mail-back-up via FormSubmit (blind: no-cors, we lezen het antwoord
      //    NIET). Zo kan de CORS-beveiliging nooit een valse foutmelding geven;
      //    de mail wordt verstuurd, meer hoeven we er niet van te weten.
      if (CFG.hasMail) {
        try { await fetch(CFG.mailEndpoint, { method: "POST", mode: "no-cors", body: data }); }
        catch (mailErr) { /* back-up onbereikbaar: de Sheet hieronder is leidend */ }
      }

      // 2) Google Sheet via JSONP. Dit antwoord KUNNEN we betrouwbaar lezen,
      //    dus de bevestiging verschijnt alleen als de registratie echt in de
      //    Sheet staat. Faalt dit (Google onbereikbaar), dan géén vals bewijs.
      if (CFG.sheetEndpoint) {
        const params = {
          naam: naam,
          email: document.getElementById("email").value,
          telefoon: document.getElementById("telefoon").value,
          volwassenen: String(volw),
          kinderen: String(kind),
          pakketten: String(pakketten),
          opmerking: document.getElementById("opmerking").value,
        };
        const resp = await jsonpVerzend(CFG.sheetEndpoint, params, 15000);
        if (!resp || !resp.ok) throw new Error("sheet");
      } else if (!CFG.hasMail) {
        return; // geen enkel endpoint ingesteld: laat de gewone POST lopen
      }

      toonBetaalstap(naam, volw, kind, pakketten);
    } catch (err) {
      // Registratie mislukte: toon een duidelijke foutmelding met mailfallback.
      if (btn) { btn.disabled = false; btn.textContent = "Registreren"; }
      if (foutEl) foutEl.classList.remove("hidden");
    }
  });
})();
`;
---

{hasEndpoint ? (
  <div>
    <form
      id="wafel-form"
      action={formAction}
      method="POST"
      class="grid gap-6 max-w-xl"
    >
      {/* FormSubmit: nette mail, redirect (no-JS fallback), honeypot + blacklist. */}
      <input type="hidden" name="_subject" value="Nieuwe wafelenbak-registratie via de website" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value={bedanktUrl} />
      <input type="hidden" name="_blacklist" value="viagra, casino" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

      <div>
        <label for="naam" class="block text-sm font-semibold text-antraciet-900 mb-1">Naam</label>
        <input id="naam" name="naam" type="text" required maxlength="100"
          class="w-full rounded-lg border border-beige-200 px-4 py-3 bg-white" />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-antraciet-900 mb-1">E-mailadres</label>
        <input id="email" name="email" type="email" required maxlength="150"
          class="w-full rounded-lg border border-beige-200 px-4 py-3 bg-white" />
      </div>

      <div>
        <label for="telefoon" class="block text-sm font-semibold text-antraciet-900 mb-1">
          Telefoon <span class="font-normal text-antraciet-500">(zodat we je kunnen bereiken)</span>
        </label>
        <input id="telefoon" name="telefoon" type="tel" required maxlength="40"
          value="+32 " placeholder="+32 470 12 34 56"
          class="w-full rounded-lg border border-beige-200 px-4 py-3 bg-white" />
      </div>

      {/* Ter plaatse: aantal personen (volwassenen + kinderen onder 12). */}
      <fieldset class="rounded-card border border-beige-200 bg-white p-5">
        <legend class="p-0 text-sm font-semibold text-antraciet-900">Kom je ter plaatse eten?</legend>
        <p class="text-sm text-antraciet-600 mb-3">
          Geef aan met hoeveel je komt. Ter plaatse betaal je per {w.eenheidEnkelvoud} ({euro(w.prijsPerWafel)}).
          Laat op 0 als je enkel wil afhalen.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="volwassenen" class="block text-sm font-medium text-antraciet-800 mb-1">Volwassenen</label>
            <input id="volwassenen" name="volwassenen" type="number" inputmode="numeric" min="0" max="50" step="1"
              value="0" class="w-28 rounded-lg border border-beige-200 px-4 py-3 bg-white" />
          </div>
          <div>
            <label for="kinderen" class="block text-sm font-medium text-antraciet-800 mb-1">Kinderen (onder 12)</label>
            <input id="kinderen" name="kinderen" type="number" inputmode="numeric" min="0" max="50" step="1"
              value="0" class="w-28 rounded-lg border border-beige-200 px-4 py-3 bg-white" />
          </div>
        </div>
      </fieldset>

      {/* Afhalen: pakketten van 5 dubbele wafels. */}
      <fieldset class="rounded-card border border-beige-200 bg-white p-5">
        <legend class="p-0 text-sm font-semibold text-antraciet-900">Wil je wafels afhalen?</legend>
        <p class="text-sm text-antraciet-600 mb-3">
          Afhalen gebeurt per pakket van {w.wafelsPerPakket} {w.eenheidMeervoud} ({euro(w.prijsPerPakket)} per pakket).
          Laat op 0 als je enkel ter plaatse komt.
        </p>
        <div>
          <label for="pakketten" class="block text-sm font-medium text-antraciet-800 mb-1">Aantal afhaalpakketten</label>
          <input id="pakketten" name="pakketten" type="number" inputmode="numeric" min="0" max="200" step="1"
            value="0" class="w-28 rounded-lg border border-beige-200 px-4 py-3 bg-white" />
        </div>

        <div class="mt-4 rounded-lg border border-goud-200 bg-goud-50 p-4">
          <p class="text-sm text-antraciet-600">
            <span id="wafel-aantal-wafels">0</span> {w.eenheidMeervoud} afhalen — vooraf te betalen aan Kom op tegen Kanker
          </p>
          <p class="mt-1 font-display text-2xl font-semibold text-antraciet-900">
            <span id="wafel-totaal">{euro(0)}</span>
          </p>
          <p class="mt-2 text-sm font-semibold text-red-700">
            Je bestelling is pas definitief zodra ze betaald is. Betalen is de volgende stap,
            meteen na het registreren.
          </p>
        </div>
      </fieldset>

      <p id="wafel-keuze-fout" class="hidden text-sm text-red-700">
        Geef aan met hoeveel je ter plaatse komt, of hoeveel afhaalpakketten je wil (of allebei).
      </p>

      <div>
        <label for="opmerking" class="block text-sm font-semibold text-antraciet-900 mb-1">
          Opmerking <span class="font-normal text-antraciet-500">(optioneel)</span>
        </label>
        <textarea id="opmerking" name="opmerking" rows="3" maxlength="1000"
          class="w-full rounded-lg border border-beige-200 px-4 py-3 bg-white"></textarea>
      </div>

      <div class="flex items-start gap-3">
        <input id="privacy" name="privacy" type="checkbox" required class="mt-1" />
        <label for="privacy" class="text-sm text-antraciet-700">
          Ik ga akkoord dat mijn gegevens gebruikt worden om mijn registratie te verwerken.
          Zie de <a href="/privacy" class="underline">privacyverklaring</a>.
        </label>
      </div>

      <button id="wafel-submit" type="submit"
        class="inline-flex items-center justify-center rounded-full bg-goud-500 text-antraciet-900 font-semibold px-6 py-3 min-h-11 w-fit">
        Registreren
      </button>

      <p id="wafel-fout" class="hidden text-sm text-red-700">
        Er ging iets mis bij het registreren. Probeer het opnieuw, of mail je bestelling rechtstreeks naar{" "}
        <a href={`mailto:${siteConfig.email}`} class="underline">{siteConfig.email}</a>.
      </p>

      <p class="text-xs text-antraciet-500">
        Afhaalpakketten betaal je vooraf via Kom op tegen Kanker (je ziet het bedrag na registratie).
        Ter plaatse betaal je per {w.eenheidEnkelvoud}. Zo komt elke euro integraal bij het goede doel terecht.
      </p>
    </form>

    {/* Betaalstap: wordt na registratie getoond via JavaScript. */}
    <div id="wafel-betaalstap" class="hidden">
      <div class="rounded-card border border-bos-100 bg-bos-100/40 p-6 sm:p-8">
        <p class="font-accent text-2xl text-bos-600">Bedankt voor je registratie 💛</p>
        <h2 class="mt-1 font-display text-2xl font-semibold text-antraciet-900">
          Je registratie is genoteerd
        </h2>
        <p class="mt-3 text-antraciet-700">
          <span id="betaal-samenvatting" class="font-semibold text-antraciet-900"></span>
        </p>

        {/* Afhaalbetaling — enkel zichtbaar bij bestelde pakketten. */}
        <div id="betaal-afhaal" class="hidden mt-6">
          <div class="rounded-lg border border-goud-300 bg-goud-50 p-4">
            <p class="font-semibold text-antraciet-900">⚠️ Je reservatie is nog niet definitief</p>
            <p class="mt-1 text-sm text-antraciet-700">
              Je afhaalpakketten zijn pas gereserveerd zodra je betaald hebt. Betalen is de laatste
              stap — doe het bij voorkeur meteen hieronder.
            </p>
          </div>
          <p class="mt-5 text-antraciet-700">
            Je <span class="font-semibold">afhaalpakketten</span> betaal je vooraf via Kom op tegen
            Kanker. Volg deze stappen — zo kunnen we je betaling koppelen aan je bestelling:
          </p>
          <ul class="mt-5 space-y-4">
            <li class="flex gap-3">
              <span class={badge}>1</span>
              <span class="text-antraciet-800 pt-0.5">
                Klik onderaan op <span class="font-semibold">“Betaal via Kom op tegen Kanker”</span>{" "}
                — je komt op de teampagina van De Sterkste Boom van Rendestede.
              </span>
            </li>
            <li class="flex gap-3">
              <span class={badge}>2</span>
              <span class="text-antraciet-800 pt-0.5">
                Klik op <span class="font-semibold">“Steun dit team”</span> en kies{" "}
                <span class="font-semibold">“Ander bedrag”</span>.
              </span>
            </li>
            <li class="flex gap-3">
              <span class={badge}>3</span>
              <span class="text-antraciet-800 pt-0.5">
                Vul exact dit bedrag in:{" "}
                <span id="betaal-bedrag" class="font-display text-xl font-semibold text-antraciet-900"></span>
              </span>
            </li>
            <li class="flex gap-3">
              <span class={badge}>4</span>
              <span class="text-antraciet-800 pt-0.5">
                Kies onderaan: <span class="font-semibold">“Het geld is ingezameld via een actie,
                inzameling of sponsoring door een bedrijf”</span>.
              </span>
            </li>
            <li class="flex gap-3">
              <span class={badge}>5</span>
              <span class="text-antraciet-800 pt-0.5">
                Bij de vraag hoe je het geld inzamelde, vul je in:{" "}
                <span id="betaal-mededeling" class="font-mono font-semibold text-antraciet-900 break-words"></span>
                <button type="button" id="copy-mededeling"
                  class="ml-1 align-baseline text-sm font-semibold text-goud-700 underline">
                  Kopieer
                </button>
              </span>
            </li>
            <li class="flex gap-3">
              <span class={badge}>6</span>
              <span class="text-antraciet-800 pt-0.5">Bevestig je betaling. Klaar! 💛</span>
            </li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-4">
            <a id="betaal-kotk" href={w.betaalUrl} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 font-semibold min-h-11 bg-goud-500 text-antraciet-900 hover:bg-goud-600 shadow-sm">
              Betaal via Kom op tegen Kanker <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        {/* Ter-plaatse-nota — enkel zichtbaar wanneer er mensen komen eten. */}
        <p id="betaal-terplaatse" class="hidden mt-6 text-sm text-antraciet-600">
          Ter plaatse betaal je per {w.eenheidEnkelvoud} ({euro(w.prijsPerWafel)}). Vergeet de tombola niet:
          koop ter plaatse een lotje en steun mee het goede doel.
        </p>

        <p class="mt-6 text-sm text-antraciet-600">
          Een vraag over je registratie? Mail gerust naar{" "}
          <a href={`mailto:${siteConfig.email}`} class="underline">{siteConfig.email}</a>.
        </p>
      </div>
    </div>

    <script is:inline set:html={script} />
  </div>
) : (
  <div class="rounded-card border border-beige-200 bg-beige-100/60 p-6 max-w-xl">
    <p class="text-antraciet-700">
      Het online registratieformulier is momenteel niet beschikbaar. Mail je bestelling gerust
      rechtstreeks — die komt bij Koen terecht.
    </p>
    <div class="mt-5">
      <Button href={`mailto:${siteConfig.email}?subject=${encodeURIComponent("Wafelenbak-bestelling")}`} variant="secondary">
        Stuur een e-mail
      </Button>
    </div>
  </div>
)}
